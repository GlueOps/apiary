[Unit]
Description=APIary fleet agent (bee)
Documentation=https://github.com/glueops/apiary
# Wants, not Requires: the agent's job includes reporting that this host is back
# after a reboot, and a hard dependency on the network being "online" would
# delay exactly the heartbeat the control plane is waiting for. It retries.
Wants=network-online.target
After=network-online.target

# StartLimitIntervalSec belongs to [Unit], NOT [Service]. systemd parses it only
# here and merely warns about it elsewhere — "Unknown key ... ignoring" — so a
# copy in [Service] reads as configured and does nothing. This was in the wrong
# section until a real install surfaced the warning in the journal.
#
# Zero disables the rate limit: a hypervisor that keeps failing to start its
# agent should keep trying, because the alternative is a host that quietly stops
# attempting and looks identical to one nobody onboarded.
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
# /usr/sbin, not /usr/local/bin. This runs as root and its job is upgrading and
# rebooting the host, so it belongs where root-only binaries belong — and
# /usr/local/bin is on every unprivileged user's PATH, which makes a root daemon
# look like something any of them could usefully run.
#
# `apiary-agent install` rewrites this line to wherever the binary actually is,
# so a host that already has it elsewhere keeps working rather than being moved.
ExecStart=/usr/sbin/apiary-agent start

# The supervision this replaces: run as a bare process and nothing notices when
# it dies. A fleet agent that has silently exited looks identical to a host that
# is quietly healthy — the control plane sees no heartbeat and, past any declared
# window, calls it offline, which is a page for a machine that is fine.
Restart=always
RestartSec=5s

# Watchdog. Type=notify plus this means systemd restarts the agent if it stops
# checking in — which catches the case Restart=always cannot: a process that is
# still running but has wedged. Both loops feed it, so a hung report loop is
# caught even while the execute loop is healthy.
WatchdogSec=60s

# Shutdown has to be gentle. A dist-upgrade may be mid-flight, and the agent
# leaves its task RUNNING locally so the restarted process resumes it — but only
# if it is allowed to finish writing.
KillSignal=SIGTERM
TimeoutStopSec=90s

# The agent runs as root because its work is upgrading and rebooting the host.
# Everything below narrows what that means in practice.
User=root
StateDirectory=apiary-agent
ConfigurationDirectory=apiary-agent
Environment=AGENT_STATE_PATH=/var/lib/apiary-agent/state.db

# Written by onboarding, and the ONLY place the control plane's address lives.
#
# The agent reads a config FILE only when --config is passed, which the unit does
# not do; everything else comes from AGENT_-prefixed environment. So without this
# the agent falls back to its compiled default of localhost:8080 and talks to the
# hypervisor itself — which fails as "connection refused" and looks like the
# control plane is down.
#
# The leading '-' means a missing file is not a startup failure: an agent with no
# env file is misconfigured, but it should say so in its own logs rather than
# refusing to start where nothing reads the reason.
EnvironmentFile=-/etc/apiary-agent/agent.env

# HARDENING, AND THE THREE THINGS IT MUST NOT TAKE AWAY.
#
# Every directive here narrows what "runs as root" means. The temptation is to
# add more; the constraint is that this agent's PRIMARY JOB is `apt-get
# dist-upgrade` on a Proxmox host, and a sandbox that breaks it makes the unit
# look hardened while quietly disabling the thing it exists for.
#
# Three directives were removed after a dist-upgrade failed three times on a
# live node, each failing at the NEXT step so the previous fix looked like
# progress rather than an answer:
#
#   CAP_SETUID   apt drops to the _apt user (uid 42) to run its download
#                methods. Without it: "seteuid 42 failed - Operation not
#                permitted", then "Method http has died unexpectedly", and
#                `apt-get update` exits 100 before a single package is read.
#                Granted ambiently rather than by dropping the whole hardening
#                block, so the narrowing that does not hurt is kept.
#
#   ProtectHome  makes /root inaccessible. The proxmox-kernel postinst writes
#                /root/.ssh and symlinks authorized_keys onto pmxcfs, so dpkg
#                fails to configure the kernel: "Could not create directory
#                '/root/.ssh' (Read-only file system)".
#
#   RestrictNamespaces  blocks unshare(2). /etc/initramfs/post-update.d/
#                proxmox-boot-sync uses it, so the initramfs trigger fails with
#                "unshare: unshare failed: Operation not permitted" and
#                initramfs-tools is left unconfigured.
#
# What remains is everything that costs this agent nothing.
NoNewPrivileges=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

# Granted back explicitly. NoNewPrivileges above still prevents GAINING
# privilege via setuid binaries; this permits only the drop to _apt that apt
# performs on itself.
AmbientCapabilities=CAP_SETUID CAP_SETGID

# NOT ProtectHome, NOT RestrictNamespaces, NOT ProtectSystem=strict, NOT
# ProtectKernelModules: see above. Each of these was measured against a real
# dist-upgrade, not reasoned about.

[Install]
WantedBy=multi-user.target
