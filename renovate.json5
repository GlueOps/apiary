// Repository overrides for Renovate. Every setting here fixes something that
// was observed rather than anticipated.
//
// DELIBERATELY MINIMAL, and with no `extends`. GlueOps applies its Renovate
// configuration org-wide from outside this repository — which is why pull
// requests here already arrive with the org's conventional-commit subjects and
// `#patch` / `#minor` suffixes despite there being no config file until now.
// Renovate merges a repository config over that global one, so listing only the
// keys being changed keeps every org convention intact. An `extends` naming a
// preset, or a fuller config copied from elsewhere, would silently replace
// policy nobody in this repository decided to change.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // ONE PULL REQUEST PER PACKAGE, NOT ONE PER MAJOR VERSION IN BETWEEN.
  //
  // The org config enables separateMultipleMajor, which opens a pull request for
  // every intermediate major: actions/checkout arrived as three separate PRs
  // moving v4 to v5, to v6 and to v7 — three ways to reach one destination, of
  // which only the last is wanted.
  //
  // Closing the intermediate ones by hand does not work. Nine were closed on
  // 2026-08-25 and Renovate recreated all nine under new numbers within the
  // hour, because a closed pull request is not a decision it can read. This
  // setting is the decision. Five packages were affected — checkout, setup-go,
  // setup-node, upload-artifact and typescript — turning what should have been
  // five updates into fourteen open pull requests.
  //
  // The cost is real and accepted: a jump straight from v4 to v7 crosses three
  // sets of breaking changes at once, so the release notes have to be read
  // rather than skimmed. That is a better trade than a queue nobody reads.
  separateMultipleMajor: false,

  // RUN `go mod tidy` AFTER A GO UPDATE.
  //
  // Renovate edits go.mod and appends to go.sum, but it does not prune: the
  // lines for the version being replaced stay behind. This repository's CI runs
  // `go mod tidy` across all four modules and fails on any diff, so every Go
  // dependency pull request failed the tidy check — four of them at once, none
  // for a reason a rebase could fix. Confirmed by running tidy on one of the
  // branches, which removed exactly the four stale go.sum lines Renovate left.
  postUpdateOptions: ["gomodTidy"],

  // AUTOMERGE, because the alternative is what this repository already had: on
  // 2026-08-25 twenty pull requests were open at once, every one of them green,
  // every one waiting for somebody to click. That rate does not fall, so the
  // queue is not a backlog to be cleared once — it is a standing tax, and a queue
  // nobody can keep up with is a queue that stops being read. The setting above
  // cuts how many arrive; this one is what drains the rest.
  //
  // platformAutomerge IS DELIBERATELY OFF, which is the opposite of the usual
  // advice, and the reason is specific to how main is protected here.
  //
  // main is governed by an org-level ruleset, not by this repository's branch
  // protection — `gh api repos/GlueOps/apiary/branches/main/protection` returns
  // an empty set, which is misleading. The real rules come from
  // `gh api repos/GlueOps/apiary/rules/branches/main`, and as of 2026-08-26 they
  // are: deletion, non_fast_forward, pull_request, workflows, copilot_code_review.
  //
  // There is NO required_status_checks rule, and required_approving_review_count
  // is 0. The `workflows` rule requires exactly one workflow, and it belongs to
  // another repository: glueops-basic-pr-checks.yml, which surfaces as the
  // PR_CHECKS_AND_LABELS check and completes in about eleven seconds.
  //
  // So nothing this repository's own CI does is required to merge. `go` takes
  // nearly seven minutes; browser tests, lint, govulncheck and the
  // generated-artifacts job are all advisory as far as the ruleset is concerned.
  // platformAutomerge hands the merge to GitHub, which fires as soon as the
  // REQUIRED gates are satisfied — eleven seconds in, with the Go suite still
  // running. That would not be automerge-when-CI-passes; it would be
  // automerge-before-CI-runs, on precisely the changes nobody is reading.
  //
  // With platformAutomerge off, Renovate merges the branch itself, and it merges
  // only when the branch status is green — which it computes from ALL checks on
  // the branch, required or not. That is the gate this repository actually wants,
  // and it is the only one available without changing the org ruleset.
  //
  // If required_status_checks is ever added to the ruleset covering main, flip
  // platformAutomerge back on: the platform gate becomes the stronger one, and it
  // survives Renovate being down.
  //
  // automergeStrategy is squash because the ruleset's allowed_merge_methods are
  // squash and rebase only; a merge commit is refused.
  automerge: true,
  platformAutomerge: false,
  automergeStrategy: "squash",

  packageRules: [
    {
      // Majors are never automerged. With separateMultipleMajor off, a major
      // update now crosses several sets of breaking changes at once — exactly the
      // cost accepted above — so it is the one update type that must be read.
      matchUpdateTypes: ["major"],
      automerge: false,
    },
    {
      // TYPESCRIPT IS PINNED IN THE ROOT MANIFEST ON PURPOSE.
      //
      // The root project is the codegen toolchain — @hey-api/openapi-ts and
      // openapi-generator-cli — and hey-api does not work under TypeScript 7,
      // which is a native rewrite rather than a version bump. A TS 7 update here
      // breaks generation of ui/src/sdk, sdk/go, sdk/ts and the Terraform
      // provider, and it breaks it at generation time, where the failure is a
      // wrong or missing artifact rather than a red test.
      //
      // Scoped by FILE, not by package, because ui/package.json carries the same
      // dependency and the SPA is free to move to 7: the two projects keep
      // separate lockfiles precisely so their compilers can differ. That is the
      // reason this repository is not a Yarn workspace, and it is written here
      // because it was written nowhere else.
      //
      // sdk/ts/package.json is deliberately NOT in this list. It has no lockfile
      // of its own and resolves through the root, so it is part of the same
      // project and the root entry already covers it.
      matchFileNames: ["package.json"],
      matchPackageNames: ["typescript"],
      allowedVersions: "<7",
    },
    {
      // The generators themselves are updated deliberately, never automatically.
      // They rewrite vendored code — ui/src/sdk, sdk/go, sdk/ts and the Terraform
      // provider — so a bump is a review of the regenerated diff, not of a version
      // number, and CI's generated-artifacts job can only prove the output is
      // committed, not that it is right.
      matchPackageNames: [
        "@hey-api/openapi-ts",
        "@openapitools/openapi-generator-cli",
      ],
      automerge: false,
    },
  ],
}
