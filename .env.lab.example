# Lab configuration for `just fleet-move` and `just lab-topology`.
#
# Copy to .env.lab and fill in. .env.lab is gitignored (.gitignore ignores
# .env.* and un-ignores only the .example files), and it holds API token secrets,
# so it must never be committed.
#
# The two clusters are named A and B rather than SOURCE and DEST on purpose:
# `just fleet-move` moves A -> B and `just fleet-move reverse` moves B -> A, so a
# node can be sent back without editing this file.

# --- cluster A ---------------------------------------------------------------
# The API URL MUST include /api2/json. The Proxmox client appends paths to this
# base verbatim, so a bare https://host:8006 produces
# `500 no such file '/cluster/status'` — which reads like a missing endpoint
# rather than a misconfigured URL. Nothing validates it.
LAB_A_API=https://10.10.10.2:8006/api2/json
# A token with privilege separation OFF. Proxmox tokens created with the default
# --privsep 1 hold no permissions of their own and answer 403 to everything:
#   pveum user token add root@pam apiary-demo --privsep 0
LAB_A_TOKEN_ID=root@pam!apiary-demo
LAB_A_SECRET=
# A node that STAYS in cluster A, as `address,nodename`. Used as the peer the
# departing node talks to, so it must not be the node being moved.
LAB_A_PEER=10.10.10.2,pve

# --- cluster B ---------------------------------------------------------------
LAB_B_API=https://10.10.10.4:8006/api2/json
LAB_B_TOKEN_ID=root@pam!apiary-demo
LAB_B_SECRET=
LAB_B_PEER=10.10.10.4,pve3

# --- the node that moves -----------------------------------------------------
# `address,nodename`. It must have NO guests: the departure gate refuses a node
# that is still carrying any, which is the whole point of the gate.
LAB_MOVING=10.10.10.3,pve2
# The address this node advertises on corosync link 0 when it joins. Normally
# the same address as above; it differs when the cluster network is separate
# from the management one.
LAB_LINK=10.10.10.3
